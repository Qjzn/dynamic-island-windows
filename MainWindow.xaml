<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:DynamicIsland.Views"
        Title="Verjot"
        Width="900" Height="720"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{DynamicResource Fg}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

  <Grid x:Name="Root">

    <!-- shown after a swipe up: hover / click / pull down to bring the island back -->
    <Grid x:Name="Handle" Width="150" Height="20" HorizontalAlignment="Center" VerticalAlignment="Top"
          Background="#01000000" Visibility="Collapsed" Cursor="Hand"
          MouseEnter="Handle_MouseEnter" MouseLeave="Handle_MouseLeave"
          MouseLeftButtonDown="Handle_MouseLeftButtonDown" MouseMove="Handle_MouseMove">
      <Border x:Name="HandlePill" Width="56" Height="6" CornerRadius="3" VerticalAlignment="Top" Margin="0,3,0,0"
              Background="{DynamicResource IslandBg}" BorderBrush="{DynamicResource Fg3}" BorderThickness="0.8"
              Opacity="0.85"/>
    </Grid>

    <!-- The island's shadow, drawn apart from the island and kept as a cached picture: the character and
         the clock can change inside the island without the shadow (a big blur) being computed again. -->
    <Canvas x:Name="ShadowHost" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Top"
            Width="200" Height="36" Margin="0,8,0,0" RenderTransformOrigin="0.5,0"
            Opacity="{Binding Opacity, ElementName=Island}" Visibility="{Binding Visibility, ElementName=Island}">
      <Canvas.CacheMode><BitmapCache/></Canvas.CacheMode>
      <Path x:Name="IslandShadowPath" Fill="Black">
        <Path.Effect>
          <DropShadowEffect x:Name="IslandShadow" BlurRadius="34" ShadowDepth="6" Opacity="0.38" Color="Black" Direction="270"/>
        </Path.Effect>
      </Path>
    </Canvas>

    <!-- The island. Its body is a Path rebuilt every frame while it moves, so the outline can ripple like liquid. -->
    <Border x:Name="Island"
            Background="Transparent"
            Width="200" Height="36"
            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
            RenderTransformOrigin="0.5,0"
            MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
            PreviewMouseLeftButtonDown="Island_PreviewMouseLeftButtonDown"
            PreviewMouseMove="Island_PreviewMouseMove"
            PreviewMouseLeftButtonUp="Island_PreviewMouseLeftButtonUp"
            PreviewMouseWheel="Island_PreviewMouseWheel"
            SizeChanged="Island_SizeChanged"
>
      <Border.RenderTransform>
        <TransformGroup>
          <ScaleTransform x:Name="IslandScale"/>
          <SkewTransform x:Name="IslandSkew"/>
          <TranslateTransform x:Name="IslandShift"/>
        </TransformGroup>
      </Border.RenderTransform>
      <Border.ContextMenu>
        <ContextMenu x:Name="IslandMenu">
          <MenuItem Header="Изменить размер…" Click="EditSize_Click"><MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" FontSize="14" Text="&#xE740;"/></MenuItem.Icon></MenuItem>
          <MenuItem Header="Выровнять по центру" Click="ResetPosition_Click"><MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" FontSize="14" Text="&#xE8E3;"/></MenuItem.Icon></MenuItem>
          <MenuItem Header="Сменить тему" InputGestureText="Ctrl+Alt+T" Click="ToggleTheme_Click"><MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" FontSize="14" Text="&#xE790;"/></MenuItem.Icon></MenuItem>
          <Separator/>
          <MenuItem Header="Спрятать (смахнуть вверх)" InputGestureText="Ctrl+Alt+I" Click="HideIsland_Click"><MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" FontSize="14" Text="&#xE70E;"/></MenuItem.Icon></MenuItem>
          <MenuItem Header="Настройки" Click="OpenSettings_Click"><MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" FontSize="14" Text="&#xE713;"/></MenuItem.Icon></MenuItem>
          <Separator/>
          <MenuItem Header="Выход" Click="Exit_Click"><MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" FontSize="14" Text="&#xE7E8;"/></MenuItem.Icon></MenuItem>
        </ContextMenu>
      </Border.ContextMenu>

      <Grid x:Name="IslandBody">
      <!-- body: tint + rim light (the colour-split effect plays on this grid when the island opens) -->
      <!-- on a Canvas: the outline may bulge outside the box (reach, ears) without being clipped -->
      <Canvas IsHitTestVisible="False">
        <!-- frosted glass: what's behind the island, blurred, clipped to its shape -->
        <Canvas x:Name="FrostHost" Visibility="Collapsed">
          <Canvas.CacheMode><BitmapCache/></Canvas.CacheMode>
          <!-- liquid glass: the lens (GlassEffect) over the blurred picture; along the rim it bends the sharp one (FrostPics) -->
          <Canvas x:Name="FrostLens">
            <Canvas x:Name="FrostClip">
              <Canvas x:Name="FrostBlur">
                <Canvas.Effect>
                  <BlurEffect Radius="36" KernelType="Gaussian" RenderingBias="Performance"/>
                </Canvas.Effect>
                <Canvas x:Name="FrostPics">
                  <!-- two pictures: a new one fades in over the one before -->
                  <Image x:Name="Frost" Stretch="Fill"/>
                  <Image x:Name="FrostNext" Stretch="Fill" Opacity="0"/>
                </Canvas>
              </Canvas>
            </Canvas>
          </Canvas>
        </Canvas>
        <!-- your own photo (Settings > Appearance > Themes), under the tint -->
        <Canvas x:Name="PhotoHost" Visibility="Collapsed">
          <Image x:Name="PhotoImage" Stretch="UniformToFill"/>
        </Canvas>
        <Path x:Name="IslandShape" Fill="{DynamicResource IslandBg}" Stroke="{DynamicResource GlassRim}" StrokeThickness="1"/>
        <!-- the animated season (spring, summer, autumn, winter themes) -->
        <Path x:Name="IslandShine" Fill="{DynamicResource GlassShine}" IsHitTestVisible="False"/>
        <!-- idle shimmer: coloured light seeping into the island from its lower edge (clipped to the shape) -->
        <Canvas x:Name="AuraHost" Visibility="Collapsed">
          <Rectangle x:Name="AuraFill">
            <Rectangle.Effect><BlurEffect Radius="14" RenderingBias="Performance"/></Rectangle.Effect>
          </Rectangle>
        </Canvas>
        <Path x:Name="AuraLine" StrokeThickness="2" Visibility="Collapsed" Opacity="0.55"/>
      </Canvas>

      <Grid x:Name="IslandContent">

        <!-- ================= COMPACT ================= -->
        <StackPanel x:Name="LiveDots" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,30,0,0" IsHitTestVisible="False" Visibility="Collapsed"/>
        <Grid x:Name="CompactView" Height="36" VerticalAlignment="Top" Margin="15,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
            <!-- live activity icon (timer ring, download, Discord, focus, calendar…) -->
            <Grid x:Name="LiveSlot" Width="22" Height="22" Visibility="Collapsed">
              <Ellipse x:Name="LiveRingBg" Stroke="{DynamicResource TrackBg}" StrokeThickness="2.5"/>
              <Path x:Name="LiveRing" Stroke="{DynamicResource Accent}" StrokeThickness="2.5"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <TextBlock x:Name="LiveIcon" FontFamily="{StaticResource IconFont}" FontSize="11"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel x:Name="Eyes" Orientation="Horizontal" RenderTransformOrigin="0.5,0.5">
              <StackPanel.RenderTransform>
                <TransformGroup>
                  <ScaleTransform x:Name="EyesScale"/>
                  <TranslateTransform x:Name="EyesShift"/>
                </TransformGroup>
              </StackPanel.RenderTransform>
              <!-- the character: drawn and animated in code, see Views/CharacterView.cs -->
              <v:CharacterView x:Name="Character"/>
            </StackPanel>
            <Border x:Name="MiniArt" Width="22" Height="22" CornerRadius="7" Margin="6,0,0,0" Background="{DynamicResource ChipBg}"
                    Visibility="Collapsed"/>
            <Ellipse x:Name="RecDot" Width="10" Height="10" Fill="{DynamicResource Danger}" Visibility="Collapsed"/>
          </StackPanel>

          <TextBlock x:Name="CompactTime" Grid.Column="1" Text="00:00" FontSize="13" FontWeight="SemiBold"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     MaxWidth="300" TextTrimming="CharacterEllipsis"/>
          <!-- karaoke: the line being sung, whole (the island sizes itself to it) -->

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
            <!-- who uses the mic / camera right now (like the iOS dots) -->
            <Ellipse x:Name="MicDot" Width="7" Height="7" Fill="#FF9F0A" Margin="0,0,5,0" Visibility="Collapsed"/>
            <Ellipse x:Name="CamDot" Width="7" Height="7" Fill="#30D158" Margin="0,0,5,0" Visibility="Collapsed"/>
            <Border x:Name="UnreadBadge" Background="{DynamicResource AccentBlue}" CornerRadius="8" Padding="6,1" Cursor="Hand" MouseLeftButtonUp="UnreadBadge_Click"
                    Margin="0,0,6,0" Visibility="Collapsed">
              <TextBlock x:Name="UnreadText" FontSize="10.5" FontWeight="SemiBold" Foreground="White"/>
            </Border>
          <Grid VerticalAlignment="Center">
            <StackPanel x:Name="CompactWeather" Orientation="Horizontal">
              <TextBlock x:Name="CompactWeatherIcon" FontFamily="{StaticResource SymbolFont}" FontSize="13"
                         Foreground="{DynamicResource Warm}" VerticalAlignment="Center" Margin="0,0,4,0"/>
              <TextBlock x:Name="CompactTemp" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel x:Name="EqBars" Orientation="Horizontal" Visibility="Collapsed" Height="16">
              <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Accent}" Margin="1,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.4"/></Rectangle.RenderTransform></Rectangle>
              <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Accent}" Margin="1,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.4"/></Rectangle.RenderTransform></Rectangle>
              <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Accent}" Margin="1,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.4"/></Rectangle.RenderTransform></Rectangle>
              <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Accent}" Margin="1,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.4"/></Rectangle.RenderTransform></Rectangle>
            </StackPanel>
          </Grid>
          </StackPanel>
        </Grid>

        <!-- ================= TOAST ================= -->
        <!-- a notice (a message, a timer, a download…). For a notification from another program (Verjot) the first
             line says who sent it, and the thin line under it empties while the notice is up -->
        <Grid x:Name="ToastView" Height="66" VerticalAlignment="Top" Margin="12,0,18,0" Visibility="Collapsed"
              Opacity="0" Cursor="Hand" MouseLeftButtonUp="Toast_Click" Background="Transparent">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border x:Name="ToastBadge" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource ChipBg}" VerticalAlignment="Center">
            <TextBlock x:Name="ToastIcon" FontFamily="{StaticResource IconFont}" FontSize="15"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <StackPanel x:Name="ToastAppRow" Orientation="Horizontal" Margin="0,0,0,1" Visibility="Collapsed">
              <Border x:Name="ToastTag" CornerRadius="6" Padding="5,1" Margin="0,0,6,0" Visibility="Collapsed">
                <TextBlock x:Name="ToastTagText" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
              </Border>
              <TextBlock x:Name="ToastApp" FontSize="10.5" Foreground="{DynamicResource Fg3}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="ToastTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="ToastText" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="32"/>
          </StackPanel>
          <Border Grid.Row="1" Grid.ColumnSpan="2" x:Name="ToastLife" Height="2" Margin="48,5,48,0" CornerRadius="1"
                  Background="{DynamicResource TrackBg}" Visibility="Collapsed">
            <Border x:Name="ToastLifeFill" CornerRadius="1" Background="{DynamicResource Accent}" RenderTransformOrigin="0,0.5">
              <Border.RenderTransform><ScaleTransform x:Name="ToastLifeScale" ScaleX="1"/></Border.RenderTransform>
            </Border>
          </Border>
        </Grid>

        <!-- ================= EXPANDED ================= -->
        <Grid x:Name="ExpandedView" Opacity="0" Visibility="Collapsed" Margin="14,10,14,14" VerticalAlignment="Top">
          <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- header: tabs, clock, settings, hide -->
          <Grid x:Name="TabArea" HorizontalAlignment="Left" VerticalAlignment="Center" Background="Transparent"
                MouseEnter="TabArea_MouseEnter" MouseLeave="TabArea_MouseLeave">
          <!-- calm state: dots + the page name; icons appear under the cursor -->
          <StackPanel x:Name="PageDots" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
            <StackPanel x:Name="DotsRow" Orientation="Horizontal" VerticalAlignment="Center"/>
            <TextBlock x:Name="PageTitle" FontSize="13.5" FontWeight="SemiBold" Margin="12,0,0,1" VerticalAlignment="Center"/>
          </StackPanel>
          <!-- one rubber pill under the chosen tab (Rubber dock): it stretches between tabs and can be dragged along them -->
          <v:RubberStack x:Name="TabStrip" Orientation="Horizontal" VerticalAlignment="Center" Rim="True" PillRadius="16">
            <v:RubberStack.RenderTransform><TranslateTransform x:Name="TabStripShift"/></v:RubberStack.RenderTransform>
            <RadioButton x:Name="TabNotify" Style="{StaticResource TabButton}" GroupName="Tabs" IsChecked="True" Content="Уведомления" Tag="&#xE7E7;" Checked="Tab_Checked"/>
            <RadioButton x:Name="TabMeeting" Style="{StaticResource TabButton}" GroupName="Tabs" Content="Встречи" Tag="&#xE720;" Checked="Tab_Checked"/>
            <RadioButton x:Name="TabChat" Style="{StaticResource TabButton}" GroupName="Tabs" Content="Чат" Tag="&#xE8BD;" Checked="Tab_Checked"/>
            <RadioButton x:Name="TabClip" Style="{StaticResource TabButton}" GroupName="Tabs" Content="Буфер" Tag="&#xE77F;" Checked="Tab_Checked"/>
            <RadioButton x:Name="TabNotes" Style="{StaticResource TabButton}" GroupName="Tabs" Content="Заметки" Tag="&#xE70B;" Checked="Tab_Checked"/>
          </v:RubberStack>
          </Grid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <v:CharacterView x:Name="MenuBuddy" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"
                             ToolTip="Нажми на меня"/>
            <!-- the menu button (Settings > Layout): the island's menu, its lines turning into a cross while open -->
            <Button x:Name="MenuButton" Style="{StaticResource IconButton}" Width="30" Height="30" Margin="0,0,4,0" Visibility="Collapsed"
                    Click="MenuButton_Click" ToolTip="Меню острова">
              <v:MenuToggleIcon x:Name="MenuToggle"/>
            </Button>
            <TextBlock x:Name="ExpandedTime" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <RadioButton x:Name="TabSettings" Style="{StaticResource TabButton}" GroupName="Tabs" Content="Настройки" Tag="&#xE713;" Checked="Tab_Checked"/>
            <Button Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="12" Content="&#xE70E;"
                    ToolTip="Спрятать (или смахните вверх)" Click="HideIsland_Click"/>
          </StackPanel>

          <Grid Grid.Row="1" Margin="0,10,0,0" x:Name="Pages">

            <!-- ======== CHAT (Verjot): the user's Hermes agent ======== -->
            <StackPanel x:Name="HermesPage" Width="580" Visibility="Collapsed">
              <DockPanel Margin="4,0,0,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button x:Name="HermesSettingsButton" Style="{StaticResource GhostPill}" Click="HermesSettings_Click"/>
                </StackPanel>
                <TextBlock x:Name="HermesTitle" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </DockPanel>
              <Border x:Name="HermesSetup" Style="{StaticResource Tile}" Padding="12,10" Margin="0,0,4,8" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock x:Name="HermesSetupHint" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="HermesUrlLabel" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <TextBox x:Name="HermesUrlBox" Style="{StaticResource SoftBox}" Grid.Column="1" Margin="8,2,0,2" LostFocus="HermesSave_Changed"/>
                    <TextBlock x:Name="HermesKeyLabel" Grid.Row="1" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <PasswordBox x:Name="HermesKeyBox" Style="{StaticResource SoftPasswordBox}" Grid.Row="1" Grid.Column="1" Margin="8,2,0,2" LostFocus="HermesSave_Changed" PasswordChanged="HermesKeyBox_Changed"/>
                    <TextBlock x:Name="HermesModelLabel" Grid.Row="2" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <TextBox x:Name="HermesModelBox" Style="{StaticResource SoftBox}" Grid.Row="2" Grid.Column="1" Margin="8,2,0,2" LostFocus="HermesSave_Changed"/>
                  </Grid>
                </StackPanel>
              </Border>
              <ScrollViewer x:Name="HermesScroll" MaxHeight="296" VerticalScrollBarVisibility="Hidden">
                <StackPanel x:Name="HermesList"/>
              </ScrollViewer>
              <DockPanel Margin="4,8,0,0">
                <Button x:Name="HermesSend" DockPanel.Dock="Right" Style="{StaticResource AccentPill}" VerticalAlignment="Top" Click="HermesSend_Click"/>
                <TextBox x:Name="HermesBox" Style="{StaticResource SoftBox}" MinHeight="36" MaxHeight="110" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Hidden" PreviewKeyDown="HermesBox_KeyDown"/>
              </DockPanel>
            </StackPanel>

            <!-- ======== ALERTS (Verjot): Windows, WeChat and WeCom notifications ======== -->
            <StackPanel x:Name="NotifyPage" Width="580" Visibility="Collapsed">
              <DockPanel Margin="0,0,0,10">
                <Border Background="{DynamicResource TileBg}" CornerRadius="14" Padding="3" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="NotifyFilterAll" Style="{StaticResource Segment}" GroupName="NotifyFilter" IsChecked="True" Checked="NotifyFilter_Checked"/>
                    <RadioButton x:Name="NotifyFilterWeChat" Style="{StaticResource Segment}" GroupName="NotifyFilter" Checked="NotifyFilter_Checked"/>
                    <RadioButton x:Name="NotifyFilterWeCom" Style="{StaticResource Segment}" GroupName="NotifyFilter" Checked="NotifyFilter_Checked"/>
                    <RadioButton x:Name="NotifyFilterSystem" Style="{StaticResource Segment}" GroupName="NotifyFilter" Checked="NotifyFilter_Checked"/>
                    <RadioButton x:Name="NotifyFilterOther" Style="{StaticResource Segment}" GroupName="NotifyFilter" Checked="NotifyFilter_Checked"/>
                  </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button x:Name="NotifyClear" Style="{StaticResource GhostPill}" Margin="4,0,0,0" Click="NotifyClear_Click"/>
                </StackPanel>
              </DockPanel>
              <Border x:Name="NotifyStatus" Style="{StaticResource Tile}" Padding="12,9" Margin="0,0,0,8" Visibility="Collapsed"
                      Cursor="Hand" MouseLeftButtonUp="NotifyStatus_Click">
                <TextBlock x:Name="NotifyStatusText" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Fg2}"/>
              </Border>
              <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Hidden">
                <StackPanel>
                  <v:NoticeList x:Name="NotifyList"/>
                  <TextBlock x:Name="NotifyEmpty" Style="{StaticResource Muted}" Margin="4,6,0,10" Visibility="Collapsed"/>
                </StackPanel>
              </ScrollViewer>
              <TextBlock x:Name="NotifyFootnote" Style="{StaticResource Muted}" Margin="4,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- ======== MEETING (Verjot): the microphone and the computer's sound ======== -->
            <StackPanel x:Name="MeetingPage" Width="580" Visibility="Collapsed">
              <Border Style="{StaticResource Tile}" Padding="14,12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid Width="96" Height="96">
                    <Ellipse Stroke="{DynamicResource TrackBg}" StrokeThickness="6"/>
                    <Path x:Name="MeetRing" Stroke="{DynamicResource Accent}" StrokeThickness="6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock x:Name="MeetTime" Text="00:00" FontSize="24" FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Center"/>
                      <TextBlock x:Name="MeetState" Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Grid>
                  <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="MeetTitle" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="MeetInfo" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                      <Button x:Name="MeetStartButton" Style="{StaticResource AccentPill}" Click="MeetingStart_Click"/>
                      <Button x:Name="MeetMicButton" Style="{StaticResource GhostPill}" Margin="8,0,0,0" Click="MeetingMic_Click"/>
                      <Button x:Name="MeetMarkButton" Style="{StaticResource GhostPill}" Margin="8,0,0,0" Click="MeetingMark_Click"/>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>
              <v:LevelWave x:Name="MeetWave" Height="34" Margin="4,10,0,0"/>
              <TextBlock x:Name="MeetRecentTitle" Style="{StaticResource Caption}" Margin="4,10,0,0"/>
              <StackPanel x:Name="MeetRecentList" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- ======== CLIPBOARD: history / shelf / text tools ======== -->
            <StackPanel x:Name="ClipPage" Width="600" Visibility="Collapsed">
              <DockPanel Margin="0,0,0,8">
                <TextBlock x:Name="ClipTitle" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource GhostPill}" Content="Очистить" HorizontalAlignment="Right" Padding="12,5" Click="ClipClear_Click"/>
              </DockPanel>
              <DockPanel Margin="0,0,0,10">
                <Button Style="{StaticResource GhostPill}" Content="Очистить" HorizontalAlignment="Right" Padding="12,5" Click="ClipClear_Click"/>
              </DockPanel>

              <StackPanel x:Name="ClipHistoryPanel">
                <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Hidden">
                  <StackPanel x:Name="ClipList"/>
                </ScrollViewer>
              </StackPanel>

            </StackPanel>

            <!-- ======== NOTES ======== -->
            <StackPanel x:Name="NotesPage" Width="580" Visibility="Collapsed">
              <!-- multi-line text must be accepted, or a pasted text keeps only its first line -->
              <TextBox x:Name="NewNoteBox" Style="{StaticResource SoftBox}" MinHeight="36" MaxHeight="150" AcceptsReturn="True"
                       TextWrapping="Wrap" VerticalScrollBarVisibility="Hidden" PreviewKeyDown="NewNoteBox_KeyDown"
                       TextChanged="NewNoteBox_TextChanged" MaxLength="100000"/>
              <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Hidden">
                <StackPanel x:Name="NotesList"/>
              </ScrollViewer>
              <!-- Verjot: where today's notes are (a Markdown file of the user's own) -->
              <DockPanel Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                  <Button x:Name="NoteOpenFile" Style="{StaticResource GhostPill}" Padding="10,4" FontSize="11.5" Click="NoteOpenFile_Click"/>
                  <Button x:Name="NoteOpenFolder" Style="{StaticResource GhostPill}" Padding="10,4" FontSize="11.5" Margin="4,0,0,0" Click="NoteOpenFolder_Click"/>
                </StackPanel>
                <TextBlock x:Name="NoteFile" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
            </StackPanel>

            <!-- ======== SETTINGS: sidebar + one section at a time ======== -->
            <Grid x:Name="SettingsPage" Width="600" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <ScrollViewer x:Name="SettingsScroll" Grid.Column="1" MaxHeight="380" Margin="0" VerticalScrollBarVisibility="Hidden">
                <Grid x:Name="SettingsSections">
<StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="外观与主题" Margin="4,0,0,6"/>
                <Border Style="{StaticResource Tile}" Margin="0,0,0,10">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="ТЕМЫ"/>
                    <WrapPanel x:Name="ThemeGallery" Margin="0,10,0,0"/>
                    <WrapPanel Margin="0,2,0,0">
                      <Button Style="{StaticResource GhostPill}" Padding="12,6" Margin="0,0,8,6" Click="ThemeStore_Click" Content="Галерея тем из интернета"/>
                      <Button Style="{StaticResource GhostPill}" Padding="12,6" Margin="0,0,8,6" Click="Photo_Click" Content="Своё фото…"/>
                      <Button x:Name="PhotoRemoveButton" Style="{StaticResource GhostPill}" Padding="12,6" Margin="0,0,8,6" Click="PhotoRemove_Click"
                              Content="Убрать фото" Visibility="Collapsed"/>
                    </WrapPanel>
                    <TextBlock x:Name="ThemeStoreStatus" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                    <WrapPanel x:Name="ThemeStore" Margin="0,8,0,0"/>
                    <StackPanel x:Name="ThemeEditorHost" Margin="0,6,0,0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" Margin="0,0,0,10">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="СТИЛЬ"/>
                    <UniformGrid Columns="2" Margin="0,10,0,0">
                      <Border x:Name="StyleDocked" Tag="dock" CornerRadius="16" BorderThickness="2" Padding="8" Margin="0,0,5,0"
                              Background="{DynamicResource ChipBg}" Cursor="Hand" MouseLeftButtonUp="StyleCard_Click">
                        <StackPanel>
                          <Border Height="58" CornerRadius="10" ClipToBounds="True">
                            <Border.Background>
                              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3B3F8F" Offset="0"/><GradientStop Color="#6A4BC4" Offset="1"/>
                              </LinearGradientBrush>
                            </Border.Background>
                            <Border Width="78" Height="17" Background="Black" CornerRadius="0,0,9,9" VerticalAlignment="Top">
                              <Border Height="1.5" Margin="10,0,10,0" VerticalAlignment="Bottom" CornerRadius="1">
                                <Border.Background>
                                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#5B8CFF" Offset="0"/><GradientStop Color="#A066FF" Offset="0.5"/><GradientStop Color="#3DE1FF" Offset="1"/>
                                  </LinearGradientBrush>
                                </Border.Background>
                              </Border>
                            </Border>
                          </Border>
                          <TextBlock Text="У края" FontSize="12.5" FontWeight="SemiBold" Margin="2,8,0,0"/>
                          <TextBlock Text="Вырастает из края экрана" Style="{StaticResource Muted}" FontSize="10.5" Margin="2,1,0,0"/>
                        </StackPanel>
                      </Border>
                      <Border x:Name="StyleFloating" Tag="float" CornerRadius="16" BorderThickness="2" Padding="8" Margin="5,0,0,0"
                              Background="{DynamicResource ChipBg}" Cursor="Hand" MouseLeftButtonUp="StyleCard_Click">
                        <StackPanel>
                          <Border Height="58" CornerRadius="10" ClipToBounds="True">
                            <Border.Background>
                              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3B3F8F" Offset="0"/><GradientStop Color="#6A4BC4" Offset="1"/>
                              </LinearGradientBrush>
                            </Border.Background>
                            <Border Width="72" Height="17" Background="Black" CornerRadius="8.5" VerticalAlignment="Top" Margin="0,6,0,0"/>
                          </Border>
                          <TextBlock Text="Плавающий" FontSize="12.5" FontWeight="SemiBold" Margin="2,8,0,0"/>
                          <TextBlock Text="Пилюля чуть ниже края" Style="{StaticResource Muted}" FontSize="10.5" Margin="2,1,0,0"/>
                        </StackPanel>
                      </Border>
                    </UniformGrid>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Tile}" Margin="0,0,0,10">
                  <StackPanel>
                    <CheckBox x:Name="DarkSwitch" Style="{StaticResource Switch}" Click="DarkSwitch_Click" Content="Тёмная тема"/>
                    <v:Scrubber x:Name="ScaleSlider" Minimum="80" Maximum="130" Step="5" Margin="0,0,0,8" ValueChanged="ScaleSlider_ValueChanged"/>
                    <CheckBox x:Name="GlassSwitch" Style="{StaticResource Switch}" Click="Glass_Click" Content="Матовое стекло"/>
                    <DockPanel x:Name="TintRow" Margin="0,4,0,4">
                      <TextBlock Text="Тон стекла" FontSize="12.5" VerticalAlignment="Center"/>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11" Content="&#xE738;" Click="TintMinus_Click"/>
                        <TextBlock x:Name="TintLabel" Width="46" TextAlignment="Center" FontSize="12.5" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11" Content="&#xE710;" Click="TintPlus_Click"/>
                      </StackPanel>
                    </DockPanel>
                    <v:Scrubber x:Name="LiquidTintSlider" Minimum="0" Maximum="100" Step="5" Margin="0,4,0,8" ValueChanged="LiquidTint_ValueChanged"/>
                    <CheckBox x:Name="FadeSwitch" Style="{StaticResource Switch}" Click="Fade_Click" Content="Прозрачный низ"/>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Tile}" Margin="0,0,0,10">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="ПЕРЕЛИВАНИЕ В ПОКОЕ"/>
                    <WrapPanel x:Name="AuraChips" Margin="0,10,0,0"/>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Tile}" Margin="0,0,0,10">
                  <StackPanel>
                    <CheckBox x:Name="BounceSwitch" Style="{StaticResource Switch}" Click="Bounce_Click" Content="Пружинка"/>
                    <DockPanel Margin="0,6,0,6">
                      <TextBlock Text="Скорость анимации" FontSize="12.5" VerticalAlignment="Center"/>
                      <Border Background="{DynamicResource TileBg}" CornerRadius="13" Padding="2" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                          <RadioButton x:Name="SpeedNormal" Style="{StaticResource Segment}" GroupName="Speed" Content="Обычная" Checked="Speed_Checked"/>
                          <RadioButton x:Name="SpeedFast" Style="{StaticResource Segment}" GroupName="Speed" Content="Быстрая" Checked="Speed_Checked"/>
                        </StackPanel>
                      </Border>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,6">
                      <TextBlock Text="Иконки страниц" FontSize="12.5" VerticalAlignment="Center"/>
                      <Border Background="{DynamicResource TileBg}" CornerRadius="13" Padding="2" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                          <RadioButton x:Name="IconsHover" Style="{StaticResource Segment}" GroupName="Icons" Content="При наведении" Checked="Icons_Checked"/>
                          <RadioButton x:Name="IconsAlways" Style="{StaticResource Segment}" GroupName="Icons" Content="Всегда" Checked="Icons_Checked"/>
                        </StackPanel>
                      </Border>
                    </DockPanel>
                    <CheckBox x:Name="LiquidSwitch" Style="{StaticResource Switch}" Click="Liquid_Click" Content="Живые волны"/>

                    <v:Scrubber x:Name="LiquidSlider" Minimum="10" Maximum="100" Step="1" Margin="0,0,0,6" Visibility="Collapsed"
                                ValueChanged="LiquidSlider_ValueChanged"/>
                  </StackPanel>
                </Border>


                <Border Style="{StaticResource Tile}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="ЦВЕТ ОСТРОВА"/>
                    <WrapPanel x:Name="SwatchPanel" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                      <TextBox x:Name="ColorBox" Style="{StaticResource SoftBox}" Width="110" Height="30" KeyDown="ColorBox_KeyDown"/>
                      <Button Style="{StaticResource ToolChip}" Content="Применить" Margin="8,0,0,0" Click="ColorApply_Click"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
                  </StackPanel>
<StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="角色" Margin="4,0,0,6"/>
                <Border Style="{StaticResource Tile}">
                  <WrapPanel x:Name="CharacterGallery"/>
                </Border>
                <Border Style="{StaticResource Tile}" Margin="0,10,0,0">
                  <StackPanel>
                    <CheckBox x:Name="HandDrawnSwitch" Style="{StaticResource Switch}" Click="HandDrawn_Click" Content="Нарисовано от руки (покадрово)"/>
                  </StackPanel>
                </Border>
                  </StackPanel>
<StackPanel>
                  </StackPanel>
<StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="行为" Margin="4,0,0,6"/>
                <Border Style="{StaticResource Tile}" Margin="0,0,0,10">
                  <DockPanel>
                    <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" Style="{StaticResource SoftCombo}" Width="250"
                              SelectionChanged="LanguageBox_SelectionChanged">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Hint}" Foreground="{DynamicResource Fg2}" FontSize="11.5"
                                       Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                          </DockPanel>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel VerticalAlignment="Top" Margin="0,1,0,0">
                      <TextBlock Text="Язык интерфейса" FontSize="13"/>
                      <TextBlock x:Name="LanguageSub" Text="Language" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
                <Border Style="{StaticResource Tile}" Margin="0,0,0,10">
                  <StackPanel>
                    <CheckBox x:Name="HoverSwitch" Style="{StaticResource Switch}" Click="Behavior_Click" Content="Раскрывать при наведении"/>
                    <CheckBox x:Name="YieldSwitch" Style="{StaticResource Switch}" Click="Behavior_Click" Content="Уступать курсору"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,-4,0,6"
                               Text="Курсор пролетает по острову (в игре, по пути к вкладкам) — остров становится прозрачным и пропускает клики к окну под ним. Задержите на нём курсор или упритесь в верхний край — и он вернётся. В играх на весь экран не мешает совсем."/>
                    <CheckBox x:Name="PlacePerAppSwitch" Style="{StaticResource Switch}" Click="Behavior_Click" Content="Своё место для каждой программы"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,-4,0,6"
                               Text="Передвиньте остров, пока программа впереди, — он запомнит это место и будет сам уезжать туда, когда она впереди. «Выровнять по центру» в меню острова возвращает этой программе обычное место."/>
                    <CheckBox x:Name="SmartSwitch" Style="{StaticResource Switch}" Click="Behavior_Click" Content="Умный остров"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,-4,0,6"
                               Text="Открывается на том, что важно сейчас (таймер, звонок, скопированное, музыка) или на вкладке, которую вы обычно открываете в это время. Пока вы печатаете, не раскрывается от курсора, а сообщения ждут паузы. При низком заряде ноутбука включает облегчённую графику. Привычки хранятся только на этом ПК."/>
                    <Button Style="{StaticResource GhostPill}" HorizontalAlignment="Left" Padding="12,6" Margin="0,0,0,10"
                            Content="Забыть привычки" Click="ResetHabits_Click"/>
                    <TextBlock Text="Прятать остров поверх программ" FontSize="13" Margin="0,6,0,6"/>
                    <WrapPanel x:Name="HideAppChips"/>
                    <TextBlock x:Name="HideAppsEmpty" Style="{StaticResource Muted}" Text="Например, игры без полного экрана или программы для созвонов" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <DockPanel Margin="0,0,0,6">
                      <Button DockPanel.Dock="Right" Style="{StaticResource GhostPill}" Padding="12,6" Margin="8,0,0,0" Content="Добавить" Click="HideAppAdd_Click"/>
                      <ComboBox x:Name="HideAppPicker" Style="{StaticResource SoftCombo}" ToolTip="Программы, запущенные сейчас"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                      <TextBlock Text="Или выберите на диске:" Style="{StaticResource Muted}" FontSize="12.5" VerticalAlignment="Center" Margin="2,0,8,0"/>
                      <Button Style="{StaticResource GhostPill}" Padding="12,5" Margin="0,0,6,0" Content="Программа…" Click="HideAppProgram_Click"
                              ToolTip="Любой .exe — даже если программа сейчас не запущена"/>
                      <Button Style="{StaticResource GhostPill}" Padding="12,5" Content="Папка…" Click="HideAppFolder_Click"
                              ToolTip="Всё, что запускается из этой папки (например, папка с игрой)"/>
                    </StackPanel>
                    <CheckBox x:Name="LockSwitch" Style="{StaticResource Switch}" Click="Behavior_Click" Content="Закрепить на месте (не перетаскивать)"/>
                    <CheckBox x:Name="CapsSwitch" Style="{StaticResource Switch}" Click="Behavior_Click" Content="Показывать Caps Lock"/>
                    <CheckBox x:Name="LayoutSwitch" Style="{StaticResource Switch}" Click="Behavior_Click" Content="Показывать смену раскладки"/>
                    <CheckBox x:Name="LevelsSwitch" Style="{StaticResource Switch}" Click="Behavior_Click" Content="Показывать громкость и яркость рядом с островом"/>
                    <CheckBox x:Name="ProgressSwitch" Style="{StaticResource Switch}" Click="Behavior_Click" Content="Копирование, распаковка и другие долгие задачи — на острове"/>
                    <CheckBox x:Name="MonitorSwitch" Style="{StaticResource Switch}" Click="Behavior_Click" Content="Переходить на монитор, где сейчас курсор"/>
                    <CheckBox x:Name="CaptureSwitch" Style="{StaticResource Switch}" Click="Behavior_Click" Content="Скрывать остров на скриншотах и демонстрации экрана"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,-4,0,8"
                               Text="Если выключить, остров будет виден на скриншотах, записи и в Zoom/Discord — стекло при этом продолжает работать. Пока работает запись NVIDIA, остров сам остаётся видимым — иначе она не пишет рабочий стол"/>

                    <CheckBox x:Name="FullscreenSwitch" Style="{StaticResource Switch}" Click="Behavior_Click" Content="Прятать в играх и полноэкранном режиме"/>
                    <DockPanel Margin="0,0,0,10">
                      <ComboBox x:Name="OpenHotkeyBox" DockPanel.Dock="Right" Style="{StaticResource SoftCombo}" Width="200"
                                SelectionChanged="OpenHotkey_Changed"/>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Открывать остров клавишами" FontSize="13"/>
                        <TextBlock x:Name="OpenHotkeyStatus" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                    </DockPanel>

                    <CheckBox x:Name="LiteSwitch" Style="{StaticResource Switch}" Click="Lite_Click" ToolTip="Без стекла, свечения и эффектов: заметно меньше нагрузка" Content="Облегчённая графика для слабых ПК"/>
                    <v:CopyButton x:Name="PerfReportButton" Style="{StaticResource GhostPill}" HorizontalAlignment="Left" Padding="12,6" Margin="0,0,0,10"
                            Click="CopyPerfReport_Click" ToolTip="Если остров дёргается — отправьте этот отчёт разработчику"/>
                    <CheckBox x:Name="NotifySwitch" Style="{StaticResource Switch}" Click="Behavior_Click" Content="在岛上显示应用通知"/>
                    <CheckBox x:Name="NotifyAllSwitch" Style="{StaticResource Switch}" Click="Behavior_Click" Content="显示所有应用的通知（不只是聊天软件）"/>
                    <TextBlock x:Name="NotifyHint" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,-4,0,8" Visibility="Collapsed"/>
                    <CheckBox x:Name="AutostartSwitch" Style="{StaticResource Switch}" Click="Autostart_Click" Content="Запускать вместе с Windows"/>
                    <Button Style="{StaticResource AccentPill}" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="14,7"
                            Click="ResetPosition_Click" ToolTip="Поставить остров ровно по центру вверху экрана">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8E3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Выровнять по центру" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Border>
                  </StackPanel>
<StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="布局" Margin="4,0,0,6"/>
                    <StackPanel x:Name="LayoutHost"/>
                  </StackPanel>
                </Grid>
              </ScrollViewer>
            </Grid>
          </Grid>
        </Grid>

        <!-- ripples from clicks spread here (clipped to the island) -->
        <Canvas x:Name="RippleLayer" IsHitTestVisible="False"/>
      </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
