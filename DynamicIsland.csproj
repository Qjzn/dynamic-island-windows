<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DynamicIsland</RootNamespace>
    <!-- Verjot on Atoll's island: the namespaces are Atoll's (the upstream code is kept as it is), the program is Verjot -->
    <AssemblyName>Verjot</AssemblyName>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <!-- Program.Main answers the agents hooks before WPF starts -->
    <StartupObject>DynamicIsland.Program</StartupObject>
    <!-- the demo and test fields are set only by the runs compiled in Debug; in a release build they stay empty -->
    <NoWarn Condition="'$(Configuration)' == 'Release'">$(NoWarn);CS0649</NoWarn>

    <Version>0.1.0</Version>
    <Product>Verjot</Product>
    <AssemblyTitle>Verjot</AssemblyTitle>
    <Description>Verjot: notes, meeting recording and the computer's notifications (Windows, WeChat, WeCom) on a Dynamic Island at the top of the screen. Built on Atoll, MIT License.</Description>
    <Copyright>Verjot (c) 2026 Qjzn, MIT License. Contains Atoll, Copyright (c) 2026 mykolaichechelnytskyi, MIT License.</Copyright>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>

    <!-- ScreenRecorderLib is native x64; keep the output path without a platform folder. -->
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DynamicIsland.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- the unit tests are a project of their own -->

    <Compile Remove="tests\**" />
    <Page Remove="artifacts\**" />
    <None Remove="artifacts\**" />
    <None Remove="tests\**" />
    <Page Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon and GDI capture; keep its names out of the way. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <PackageReference Include="NAudio.WinMM" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <EmbeddedResource Include="Assets\lang\*.json" />
    <EmbeddedResource Include="CHANGELOG.md" LogicalName="DynamicIsland.CHANGELOG.md" />
  </ItemGroup>

</Project>
